- extend 'layout.haml'

.row
    .col-sm-12{align: "center"}
        %h1 Ranking
%br
.row
    .col-sm-6{align: "center"}
        %h2
        %h5
    .col-sm-6{align: "center"}
        %h2
        %h5
%br
%br
.card
    .row
        .col-xs-12
            %h2 High score players
            %table.table.table-hover.table-responsive
                %thead
                    %tr
                        %th Name:
                        %th Points:
                %tbody
                    - for rank in ranks
                        %p
                            %tr
                                %td
                                    %a{href: "#"}
                                        = rank.user.first_name
                                %td
                                    = rank.points
