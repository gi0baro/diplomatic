- extend 'layout.haml'

.row
    .col-sm-12{align: "center"}
        %h1 Statistics
%br
.row
    .col-sm-6{align: "center"}
        %h2
            = active
        %h5 Active games right now
    .col-sm-6{align: "center"}
        %h2
            = completed
        %h5 Completed games
%br
%br
.row.m-15
    .card
        .row
            .col-xs-12
                %h2 Top played variants
                %table.table.table-hover.table-responsive
                    %thead
                        %tr
                            %th Name:
                            %th Games:
                    %tbody
                        - for variant in pvariants
                            %p
                                %tr
                                    %td
                                        %a{href: "#"}
                                            = variant.name
                                    %td
                                        = variant.ngames
