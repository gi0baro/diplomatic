!!! 5
%html
    %head
        %title {{=current.response.meta.title or 'nuDiplomacy'}}
        %meta{name: "viewport", content:"width=device-width, initial-scale=1"}
        - include_meta

        - include_helpers
        - include_bs3

        - assets 'css_base'
        - assets 'js_base'

        - block head
        - end

    %body
        - include 'header.haml'

        :javascript
            api.route('join', '{{=url("api.game_join")}}');
            api.route('game', '{{=url("games.play")}}');

        .content
            - block center
            - include
            - end

        %footer
            .pull-left nuDiplomacy 0.1 beta
            .pull-right crafted with weppy framework
