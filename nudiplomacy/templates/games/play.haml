- extend 'ingame.haml'

- if player_country
    :javascript
        var currentPlayer = "{{=player_country}}";
        var currentReady = {{='true' if player_ready else 'false'}};
- else
    :javascript
        var currentPlayer = null;
        var currentReady = false;

:javascript
    var preGame = {{='true' if game.stage == 0 else 'false'}};
    var gameOver = {{='true' if game.stage == 5 else 'false'}};
    // var GROUND_COLOR = {r: 226, g: 198, b: 158};
    var GROUND_COLOR = {r: 64, g: 64, b: 64};
    // var SEA_COLOR: {r: 197, g: 223, b: 234};
    // var SEA_COLOR = {r: 26, g: 52, b: 87};
    var SEA_COLOR = {r: 81, g: 111, b: 124};
    // var NEUTRAL_COLOR = {r: 0, g: 0, b: 0};
    var NEUTRAL_COLOR = {r: 20, g: 20, b: 20};

    T.register({
        spring: '{{=T("spring").title()}}',
        autumn: '{{=T("autumn").title()}}'
    }, 'season');
    T.register({
        retreats: '{{=T("retreats").title()}}',
        builds: '{{=T("builds").title()}}',
        pregame: '{{=T("pre-game").title()}}'
    }, 'phase_type');
    T.register({
        hold: '{{=T(":TERRITORY: holds")}}',
        move: '{{=T(":SRC: moves to :DST::THROUGH::COAST:")}}',
        support_move: '{{=T(":TERRITORY: supports :SRC: in movement to :DST:")}}',
        sopport_hold: '{{=T(":TERRITORY: supports :DST: on hold")}}',
        convoy: '{{=T(":TERRITORY: convoys :SRC: to :DST:")}}',
        retreat: '{{=T(":TERRITORY: retreats to :DST::COAST:")}}',
        build: '{{=T(":TERRITORY: builds a new :TROOP_TYPE::AT_COAST:")}}',
        disband: '{{=T(":TERRITORY: disbands")}}',
        through: '{{=T("via convoy")}}',
        north_coast: '{{=T("north coast")}}',
        south_coast: '{{=T("south coast")}}',
        at_north_coast: '{{=T("at north coast")}}',
        at_south_coast: '{{=T("at south coast")}}',
        army: '{{=T("army")}}',
        fleet: '{{=T("fleet")}}'
    }, 'order_phrase')

    $(document).ready(function() {
        app.net.route("map", "{{=url('api.map_get', game.map)}}");
        app.net.route("game", "{{=url('api.game_get', game.id)}}");
        app.net.route("phases", "{{=url('api.game_phases', game.id)}}");
        app.net.route("status", "{{=url.ws('ws.game_state', game.id, scheme=True)}}");
        app.net.route("orders", "{{=url('api.authorized.game_orders', game.id)}}");
        app.net.route("phase_orders", "{{=url('api.phase_orders', ':PHASE_ID:')}}");
        app.net.route("save_orders", "{{=url('api.authorized.order_save', ':ORDER_ID:')}}");
        app.net.route("ready", "{{=url('api.authorized.player_ready', game.id)}}");
        app.net.route("messages", "{{=url('api.authorized.chat_get')}}");
        app.net.route("postmessage", "{{#=url('api.chat_post')}}");
        app.net.route("readmessage", "{{#=url('api.chat_read')}}");
        app.game.scsToWin = {{=scs}};
        app.start();
        if (!preGame) {
            counters.add('top_menu_timer', {{=timer.s}}, {{=timer.m}}, {{=timer.h}}, {{=timer.d}});
        }
    });

- ocountries = [el.country for el in players if el.country != player_country]
.container.container_ce
    %section#main.main.row
        #left_wrapper.nulled
            #msg_wrapper
                #msg_content
                    .wrap_tit
                        %span Messages
                    .msg_select
                        #msg_sel_global.msg_select_child.nulled G
                        - for country in ocountries
                            .msg_select_child.nulled{id: 'msg_sel_{{=country}}'}
                                = country[0].upper()
                    #msg_conv_global.msg_conv.ninja{'data-cid': '{{=chats["global"]}}'}
                        .msg_back
                            Back
                        .msg_list
                        %textarea#msg_text_global.msg_text
                        .btn.btn-sm.btn-warning.send_button{onclick: 'javascript: app.ui.sendMessage("global", "{{=chats["global"]}}");'}
                            %i.fa.fa-send
                    - for country in ocountries
                        .msg_conv.ninja{id: 'msg_conv_{{=country}}', 'data-cid': '{{=chats.get(country, 0)}}'}
                            .msg_back
                                Back
                            .msg_list
                            %textarea.msg_text{id: 'msg_text_{{=country}}'}
                            .btn.btn-sm.btn-warning.send_button{onclick: 'javascript: app.ui.sendMessage("{{=country}}", "{{=chats.get(country, 0)}}");'}
                                %i.fa.fa-send
            #left_menu
                #msg_button
                    %i.fa.fa-envelope.fa-lg
                #msg_ext_button >>

        #cont_wrapper
            #map_wrapper
                %img#map_img{src: '{{=url("main.download", game.map.image)}}'}
            #terr_menu.menu_butt
                #btn_m.btn.btn-default.btn-xs.btn_m
                    %i.fa.fa-crosshairs.fa-lg
                #btn_sm.btn.btn-default.btn-xs.btn_sm
                    %i.fa.fa-reply-all.fa-lg
                #btn_sh.btn.btn-default.btn-xs.btn_sh
                    %i.fa.fa-shield.fa-lg
                #btn_c.btn.btn-default.btn-xs.btn_c.ninja
                    %i.fa.fa-life-ring.fa-lg
                #btn_x.btn.btn-default.btn-xs.btn_x
                    %i.fa.fa-remove.fa-lg
            #mcoast_menu.menu_butt
                #btn_n.btn.btn-default.btn-xs.btn_mc_n N
                #btn_s.btn.btn-default.btn-xs.btn_mc_s S
            #build_menu.menu_butt
                #btn_b_a.btn.btn-default.btn-xs.btn_build_a
                    %i.fa.fa-truck.fa-lg
                #btn_b_f.btn.btn-default.btn-xs.btn_build_f.ninja
                    %i.fa.fa-anchor.fa-lg
                #btn_b_x.btn.btn-default.btn-xs.btn_x
                    %i.fa.fa-remove.fa-lg
            #build_menu_d.menu_butt
                #btn_b_d.btn.btn-default.btn-xs.btn_build_d
                    %i.fa.fa-certificate.fa-lg
                #btn_bd_x.btn.btn-default.btn-xs.btn_x
                    %i.fa.fa-remove.fa-lg
            #retreat_menu.menu_butt
                #btn_r_r.btn.btn-default.btn-xs.btn_retreat_r
                    %i.fa.fa-share.fa-lg
                #btn_r_d.btn.btn-default.btn-xs.btn_retreat_d
                    %i.fa.fa-certificate.fa-lg
                #btn_r_x.btn.btn-default.btn-xs.btn_x
                    %i.fa.fa-remove.fa-lg

        #top_menu
            #top_menu_nav
                #phase_rr.top_menu_button
                    %i.fa.fa-angle-double-left
                #phase_r.top_menu_button
                    %i.fa.fa-angle-left
                #phase_ind
                #top_menu_timer
                #phase_f.top_menu_button
                    %i.fa.fa-angle-right
                #phase_ff.top_menu_button
                    %i.fa.fa-angle-double-right

        #stats_wrapper.nulled
            #stats_top
                #stats_button
                    #stats_dot
                    #stats_text
                        = player_country or 'stats'
                    #stats_c
            #stats_content
                .row{style: "margin: 0;"}
                    - for player in players
                        %div{class: "col-md-{{=statscol}}"}
                            .stats_member{id: "stats_{{=player.country}}"}
                                %h4{id: "stats_{{=player.country}}_name"}
                                    = player.country
                                .row
                                    .col-md-4.stats_chart
                                        %canvas{id: 'stats_{{=player.country}}_canv', height: '10', width: '10'}
                                        .stats_over{id: 'stats_{{=player.country}}_perc'}
                                    .col-md-8.stats_pdata
                                        .row
                                            .col-md-12
                                                %i.fa.fa-check.fa-fw{id: "stats_{{=player.country}}_ready"}
                                                - if not game.anonymous
                                                    %h5{style: "display: inline-block;"}
                                                        = player.user.username
                                            .col-md-12
                                                .row
                                                    .col-md-8
                                                        = T("Troops: ")
                                                    .col-md-4{id: "stats_{{=player.country}}_troops"}
                                                    .col-md-3
                                                        %img{src: '{{=url("static", "images/tank.png")}}'}
                                                    .col-md-3{id: "stats_{{=player.country}}_armies"}
                                                    .col-md-3
                                                        %img{src: '{{=url("static", "images/ship.png")}}'}
                                                    .col-md-3{id: "stats_{{=player.country}}_fleets"}

        #right_wrapper
            #ord_wrapper
                .row.ordrow
                    .col-md-8
                        Orders
                    #savebtns.col-md-4
                        %i#icon_save.fa.fa-save.fa-border.off{onclick: 'javascript: app.ui.saveOrders();'}
                        %i#icon_ready.fa.fa-check.fa-border.on{onclick: 'javascript: app.ui.setReady();'}
                #ord_date
                - all_phases = game.phases()
                - #phase_count = game.phases.count()
                - phase_count = len(all_phases)
                - if phase_count > 1
                    - for i in range(1, phase_count - 1)
                        - phase = all_phases[i]
                        .ord_phase_wrapper{id: 'orders_{{=i}}'}
                            - for country, orders in {}.items()
                                - div = "orders_"+str(i)+"_"+country
                                .ord_pin{id: '{{=div}}'}
                                    .ord_pin_head{id: '{{=div+"_head"}}'}
                                        .ord_pin_icon{id: '{{=div+"_icon"}}'}
                                            %i.fa.fa-caret-right
                                        .ord_pin_text.ord_pin_text_off{id: '{{=div+"_text"}}'}
                                            = country+" orders"
                                    .orders{id: '{{=div+"_data"}}'}
                - if phase_count
                    #orders_next.ord_phase_wrapper
                        #orders_next_me.ord_pin
                            #orders_next_me_head.ord_pin_head
                                #orders_next_me_icon.ord_pin_icon
                                    %i.fa.fa-caret-right
                                #orders_next_me_text.ord_pin_text.ord_pin_text_off
                                    My orders
                            #orders_next_me_data.orders
                        #readyorders.nulled
                            = T("You're ready")
                %h5#noorders.nulled
                    No past orders to show


            #right_menu
                #ord_button
                    %i#icon_ord.fa.fa-check-square-o.fa-lg.off

        #loader
            #loader_cont
                %h1 Loading..

        #pregame.announce.nulled
            = T("This is a pre-game phase. The game will start when all the players have been joined.")

        #win.announce.nulled

.ninja
    %img#army_img{src: '{{=url("static", "images/tank.png")}}'}
    %img#ship_img{src: '{{=url("static", "images/ship.png")}}'}

.navbar.navbar-fixed-bottom
    .navbar-inner
        .container
        .container_foot
            .copyright.pull-left Copyright &#169; 2016 nuDiplomacy
            #poweredBy.pull-right coded by gi0baro with TONS of caffeine
