- extend 'ingame.haml'

:javascript
    var preGame = {{='true' if game.status == 'pregame' else 'false'}};
    $(document).ready(function() {
        app.net.route("map", "{{=url('api.map_get', game.map)}}");
        app.net.route("game", "{{=url('api.game_get', game.id)}}");
        app.net.route("orders", "{{=url('api.orders_get', game.id)}}");
        app.net.route("saveorders", "{{=url('api.orders_save', game.id)}}");
        app.net.route("ready", "{{=url('api.orders_ready', game.id, {'set': '1'})}}");
        app.net.route("unready", "{{=url('api.orders_ready', game.id)}}");
        app.game.scsToWin = {{=scs}};
        app.start();
        if (!preGame) {
            counters.add('top_menu_timer', {{=timer.s}}, {{=timer.m}}, {{=timer.h}}, {{=timer.d}});
        }
    });

.container.container_ce
    %section#main.main.row
        #left_wrapper.nulled
            #msg_wrapper
                #msg_content
                    .wrap_tit
                        %span Messages
                    .msg_select
                        #msg_sel_global.msg_select_child.nulled G
                        - for country, uoid in game.countries.iteritems()
                            .msg_select_child.nulled{id: 'msg_sel_{{=country}}'}
                                = country[0].upper()
                    #msg_conv_global.msg_conv.ninja
                        .msg_back
                            Back
                        .msg_list
                            .msg_me Test msg me G
                            .msg_re Test msg re G
                        %textarea#msg_text_global.msg_text
                    - for country in game.countries.iterkeys()
                        .msg_conv.ninja{id: 'msg_conv_{{=country}}'}
                            .msg_back
                                Back
                            .msg_list
                                .msg_me
                                    = "Test msg me "+country
                                .msg_re
                                    = "Test msg re "+country
                            %textarea.msg_text{id: 'msg_text_{{=country}}'}
            #left_menu
                #msg_button
                    %i.fa.fa-envelope.fa-lg
                #msg_ext_button >>

        #cont_wrapper
            #map_wrapper
                %img#map_img{src: '{{=url("main.download", game.map.image)}}'}
            #terr_menu.menu_butt
                #btn_m.btn.btn-default.btn-xs.btn_m
                    %i.fa.fa-crosshairs.fa-lg
                #btn_sm.btn.btn-default.btn-xs.btn_sm
                    %i.fa.fa-reply-all.fa-lg
                #btn_sh.btn.btn-default.btn-xs.btn_sh
                    %i.fa.fa-shield.fa-lg
                #btn_c.btn.btn-default.btn-xs.btn_c.ninja
                    %i.fa.fa-life-ring.fa-lg
                #btn_x.btn.btn-default.btn-xs.btn_x
                    %i.fa.fa-remove.fa-lg
            #mcoast_menu.menu_butt
                #btn_n.btn.btn-default.btn-xs.btn_mc_n N
                #btn_s.btn.btn-default.btn-xs.btn_mc_s S
            #build_menu.menu_butt
                #btn_b_a.btn.btn-default.btn-xs.btn_build_a
                    %i.fa.fa-truck.fa-lg
                #btn_b_f.btn.btn-default.btn-xs.btn_build_f.ninja
                    %i.fa.fa-anchor.fa-lg
                #btn_b_x.btn.btn-default.btn-xs.btn_x
                    %i.fa.fa-remove.fa-lg
            #build_menu_d.menu_butt
                #btn_b_d.btn.btn-default.btn-xs.btn_build_d
                    %i.fa.fa-certificate.fa-lg
                #btn_bd_x.btn.btn-default.btn-xs.btn_x
                    %i.fa.fa-remove.fa-lg
            #retreat_menu.menu_butt
                #btn_r_r.btn.btn-default.btn-xs.btn_retreat_r
                    %i.fa.fa-share.fa-lg
                #btn_r_d.btn.btn-default.btn-xs.btn_retreat_d
                    %i.fa.fa-certificate.fa-lg
                #btn_r_x.btn.btn-default.btn-xs.btn_x
                    %i.fa.fa-remove.fa-lg

        #top_menu
            #top_menu_nav
                #phase_rr.top_menu_button
                    %i.fa.fa-angle-double-left
                #phase_r.top_menu_button
                    %i.fa.fa-angle-left
                #phase_ind
                #top_menu_timer
                #phase_f.top_menu_button
                    %i.fa.fa-angle-right
                #phase_ff.top_menu_button
                    %i.fa.fa-angle-double-right

        #stats_wrapper.nulled
            #stats_top
                #stats_button
                    #stats_dot
                    #stats_text
                        {{=game.playercountry() or 'stats'}}
                    #stats_c
            #stats_content
                .row{style: "margin: 0;"}
                    - for country in game.countries.iterkeys():
                        %div{class: "col-md-{{=statscol}}"}
                            .stats_member{id: "stats_{{=country}}"}
                                %h4{id: "stats_{{=country}}_name"}
                                    = country
                                .row.stats_chart
                                    %canvas{id: 'stats_{{=country}}_canv', height: '10', width: '10'}
                                    .stats_over{id: 'stats_{{=country}}_perc'}
                                .row.stats_mdata
                                    .stats_uinfo
                                    .stats_pinfo

        #right_wrapper
            #ord_wrapper
                .row.ordrow
                    .col-md-8
                        Orders
                    #savebtns.col-md-4
                        %i#icon_save.fa.fa-save.fa-border.off{onclick: 'javascript: app.ui.saveOrders();'}
                        %i#icon_ready.fa.fa-check.fa-border.on{onclick: 'javascript: app.ui.setReady();'}
                #ord_date
                - if len(game.phases) > 2
                    - for i in range(1, len(game.phases)-1)
                        - phase = game.phases[i]
                        .ord_phase_wrapper{id: 'orders_{{=i}}'}
                            - for country, orders in phase['orders'].iteritems()
                                - div = "orders_"+str(i)+"_"+country
                                .ord_pin{id: '{{=div}}'}
                                    .ord_pin_head{id: '{{=div+"_head"}}'}
                                        .ord_pin_icon{id: '{{=div+"_icon"}}'}
                                            %i.fa.fa-caret-right
                                        .ord_pin_text.ord_pin_text_off{id: '{{=div+"_text"}}'}
                                            = country+" orders"
                                    .orders{id: '{{=div+"_data"}}'}
                - if len(game.phases) > 1
                    #orders_next.ord_phase_wrapper
                        #orders_next_me.ord_pin
                            #orders_next_me_head.ord_pin_head
                                #orders_next_me_icon.ord_pin_icon
                                    %i.fa.fa-caret-right
                                #orders_next_me_text.ord_pin_text.ord_pin_text_off
                                    My orders
                            #orders_next_me_data.orders
                        #readyorders.nulled
                            = T("You're ready")
                %h5#noorders.nulled
                    No past orders to show


            #right_menu
                #ord_button
                    %i#icon_ord.fa.fa-check-square-o.fa-lg.off

        #loader
            #loader_cont
                %h1 Loading..

        #pregame.announce.nulled
            = T("This is a pre-game phase. The game will start when all the players have been joined.")

        #win.announce.nulled

.ninja
    %img#army_img{src: '{{=url("static", "images/tank.png")}}'}
    %img#ship_img{src: '{{=url("static", "images/ship.png")}}'}

.navbar.navbar-fixed-bottom
    .navbar-inner
        .container
        .container_foot
            .copyright.pull-left Copyright &#169; 2015 nuDiplomacy
