- extend 'layout.haml'

.container
    .row
        .js-masonry
            - for game in games
                .card.game-item
                    %h5.grey-light
                        = game.map.name
                    %h3
                        = game.name
                    .row
                        .col-md-4
                            %h6.grey-light
                                = T("players no.")
                            = str(game.playersin())+"/"+str(game.nplayers)
                        .col-md-4
                            %h6.grey-light
                                = T("Bet amount")
                            = game.bet
                        .col-md-4
                            %h6.grey-light
                                = T("Phase duration")
                            = pretty_gamephasetime(game.phasetime)
                    - if game.buildew
                        .row
                            .col-md-12
                                %i.fa.fa-globe.fa-fw
                                %h6
                                    = T("This is a build-everywhere game")
                    - if game.buildonstart
                        .row
                            .col-md-12
                                %i.fa-truck.fa-fw
                                %h6
                                    = T("This game will start with a build turn")
                    %hr.divider
                    .row
                        - if not game.playercountry()
                            .col-md-6
                                %a{href: '{{=url("games.play", game.id)}}'}
                                    .btn.btn-default
                                        = T("Watch")
                            .col-md-6
                                .btn.btn-primary{onclick: 'javascript: act.joinGame("{{=game.id}}", "{{=game.bet}}");'}
                                    = T("Join")
                        - else
                            .col-md-12
                                %a{href: '{{=url("games.play", game.id)}}'}
                                    .btn.btn-success
                                        = T("Enter")

#joinframe.container.nulled.overframe
    .backframe
    .row.intframe
        .col-md-3
        .col-md-6
            .box.border.white
                .box-title
                    = T("Join the game")
                    %i.fa.fa-close.pull-right{onclick: 'javascript: act.hideJoinFrame();'}
                .row.m-15{style: 'text-align: center;'}
                    #joinmsg.col-md-12
                        = T("In order to join this game you will spend")
                        %h3#betwarn
                        = T("of your credits.")
                    #joinbtn.col-md-12{style: 'margin-top: 15px;'}
                        .btn.btn-success{onclick: 'javascript: act.confirmJoinGame(act.jgid)'}
                            = T("Join the game")
        .col-md-3
