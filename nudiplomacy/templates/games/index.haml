- extend 'layout.haml'

:javascript
    var ulist = '{{=url("games.query")}}';

.container
    .row
        .col-sm-12{align: "center"}
            %h1#title
                = T("Discover open games") if show == "open" else T("Discover games")
            %h4.pull-left
                - if show == "open"
                    %a.btn.btn-default.btn-md{href: '{{=url("games.all")}}'}
                        Show all games
                - else
                    %a.btn.btn-default.btn-md{href: '{{=url("games.index")}}'}
                        Show open games
                %a.btn.btn-success.btn-md{href: '{{=url("games.new")}}'}
                    = T("Create a new game")
    %br
    .row
        #games.js-masonry
            :javascript
                ajax('{{=url("games.query", show)}}', [], 'games');

#joinframe.container.nulled.overframe
    .backframe
    .row.intframe
        .col-md-3
        .col-md-6
            .box.border.white
                .box-title
                    = T("Join the game")
                    %i.fa.fa-close.pull-right{onclick: 'javascript: act.hideJoinFrame();'}
                .row.m-15{style: 'text-align: center;'}
                    #joinmsg.col-md-12
                        = T("In order to join this game you will spend")
                        %h3#betwarn
                        = T("of your credits.")
                    #joinerr.col-md-12.bg-warning.nulled
                    #joinpsw.col-md-12.nulled
                        .form-group
                            %label{for: "psw"}
                                = T("This game requires the password")
                            %input#joinpswinput.form-control{type: "password", name: "psw"}
                    #joincountry.nulled
                        .form-group
                            %label{for: "country"}
                                = T("Choose the country")
                            %select#joincountrysel.form-control{name: "country"}
                    #joinbtn.col-md-12{style: 'margin-top: 15px;'}
                        .btn.btn-success{onclick: 'javascript: act.confirmJoinGame(act.jgid)'}
                            = T("Join the game")
        .col-md-3
