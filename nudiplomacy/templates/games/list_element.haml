.card.game-item
    %h5.grey-light
        = game.map.name
    %h3
        = game.name
    - if not game.anonymous
        = "by " + game.user.username
    .row
        .col-md-4
            %h5.grey-light
                = T("Players no.")
            = str(game.players.count())+"/"+str(len(game.countries))
        .col-md-4{class: '{{=betclass}}'}
            %h5.grey-light
                = T("Bet amount")
            = game.bet
        .col-md-4
            %h5.grey-light
                = T("Phase duration")
            = pretty_gamephasetime(game.phase_time)
    - if game.build_everywhere
        .row
            .col-md-12
                %h6
                    %i.fa.fa-globe.fa-fw
                    = T("build-everywhere game")
    - if game.build_on_start
        .row
            .col-md-12
                %h6
                    %i.fa.fa-truck.fa-fw
                    = T("starts with a build turn")
    - if game.access == "password"
        .row
            .col-md-12
                %h6
                    %i.fa.fa-lock.fa-fw
                    = T("password protected")
    - if game.skip_processing
        .row
            .col-md-12
                %h6
                    = T("won't be processed on:")
                %h6.grey-light
                    = " ".join(str(T(d)) for d in game.skip_proc)
    .row
        .col-md-12
            - if game.stage == 0
                %h5
                    = T("Time left to join")
                - timer = game.timer()
                %h4{id: 'timer_{{=game.id}}'}
                :javascript
                    counters.add('timer_{{=game.id}}', {{=timer.s}}, {{=timer.m}}, {{=timer.h}}, {{=timer.d}});
            - else
                %h5
                    - if game.phases[-1].get('season') is not None
                        = game.phases[-1]['season']+" "+str(game.phases[-1]['year'])
                    - else
                        = game.phases[-1]['type']+" "+str(game.phases[-1]['year'])
    %hr.divider
    .row
        - if current_user() and not game.player_country(current_user())
            .col-md-6
                %a{href: '{{=url(".play", game.id)}}'}
                    .btn.btn-default
                        = T("Watch")
            - if game.is_open
                .col-md-6
                    - gp = game.password if game.access == "password" else "none"
                    - gc = "yes" if game.countries_assignment == 1 else "nope"
                    .btn.btn-primary{id: 'joinb_{{=game.id}}', onclick: 'javascript: act.joinGame("{{=game.id}}", "{{=game.bet}}", "{{=gc}}", "{{=gp}}");'}
                        = T("Join")
        - else
            .col-md-12
                %a{href: '{{=url(".play", game.id)}}'}
                    .btn.btn-success
                        = T("Enter")
    %img.flag{src: '{{=url("static", "images/flags/"+game.lang+".png")}}'}
