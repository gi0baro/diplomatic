- for game in games
    ---
        if game.bet >= 10 and game.bet < 30:
            betclass = "alert alert-info"
        elif game.bet >= 30 and game.bet < 50:
            betclass = "alert alert-success"
        elif game.bet >= 50 and game.bet < 85:
            betclass = "alert alert-warning"
        elif game.bet >= 85:
            betclass = "alert alert-danger"
        else:
            betclass = ""
        pass
    .col-md-4
        .card.game-item
            %h5.grey-light
                = game.map.name
            %h3
                = game.name
            - if not game.anonymous
                = "by "+game.owner.username
            .row
                .col-md-4
                    %h5.grey-light
                        = T("Players no.")
                    = str(game.playersin())+"/"+str(game.nplayers)
                .col-md-4{class: '{{=betclass}}'}
                    %h5.grey-light
                        = T("Bet amount")
                    = game.bet
                .col-md-4
                    %h5.grey-light
                        = T("Phase duration")
                    = pretty_gamephasetime(game.phasetime)
            - if game.buildew
                .row
                    .col-md-12
                        %h6
                            %i.fa.fa-globe.fa-fw
                            = T("build-everywhere game")
            - if game.buildonstart
                .row
                    .col-md-12
                        %h6
                            %i.fa.fa-truck.fa-fw
                            = T("starts with a build turn")
            - if game.access == "password"
                .row
                    .col-md-12
                        %h6
                            %i.fa.fa-lock.fa-fw
                            = T("password protected")
            - if game.skipproc
                .row
                    .col-md-12
                        %h6
                            = T("won't be processed on:")
                        %h6.grey-light
                            = " ".join(str(T(d)) for d in game.skipproc)
            .row
                .col-md-12
                    - if game.status == "pregame"
                        %h5
                            = T("Time left to join")
                        - timer = game.timetonext()
                        %h4{id: 'timer_{{=game.id}}'}
                        :javascript
                            counters.add('timer_{{=game.id}}', {{=timer.s}}, {{=timer.m}}, {{=timer.h}}, {{=timer.d}});
                    - else
                        %h5
                            - if game.phases[-1].get('season') is not None
                                = game.phases[-1]['season']+" "+str(game.phases[-1]['year'])
                            - else
                                = game.phases[-1]['type']+" "+str(game.phases[-1]['year'])
            %hr.divider
            .row
                - if not game.playercountry()
                    .col-md-6
                        %a{href: '{{=url("games.play", game.id)}}'}
                            .btn.btn-default
                                = T("Watch")
                    - if game.open
                        .col-md-6
                            - gp = game.password if game.access == "password" else "none"
                            - gc = "yes" if game.countriesassign == "choose" else "nope"
                            :javascript
                                act.jce['{{=game.id}}'] = {{=asis(game._jslots)}};
                            .btn.btn-primary{id: 'joinb_{{=game.id}}', onclick: 'javascript: act.joinGame("{{=game.id}}", "{{=game.bet}}", "{{=gc}}", "{{=gp}}");'}
                                = T("Join")
                - else
                    .col-md-12
                        %a{href: '{{=url("games.play", game.id)}}'}
                            .btn.btn-success
                                = T("Enter")
            %img.flag{src: '{{=url("static", "images/flags/"+game.lang+".png")}}'}
- if not games
    %h3
        = T("Seems we don't have any game to show up.")
