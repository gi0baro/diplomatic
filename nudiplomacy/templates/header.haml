%nav.navbar.navbar-default.navbar-fixed-top{role: "navigation", style: "color:white;"}
    .container-fluid
        .navbar-header
            %button.navbar-toggle{type: "button", data-toggle:"collapse", data-target:"#bs-example-navbar-collapse-1"}
                %span.sr-only Toggle navigation
                %span.icon-bar
                %span.icon-bar
                %span.icon-bar
            %a.navbar-brand{href:"/"}
                / %img{src:"{{=url('static', 'images/logo.png')}}"}
                nuDiplomacy
        / Collect the nav links, forms, and other content for toggling
        #bs-example-navbar-collapse-1.collapse.navbar-collapse
            %ul.nav.navbar-nav.nav-pills.pull-right
                %li
                    %a{href: '{{=url("games.index")}}'}
                        = T("Games")
                %li
                    %a{href: '{{=url("main.ranking")}}'}
                        = T("Ranking")
                %li
                    %a{href: '{{=url("main.stats")}}'}
                        = T("Stats")
                - if current_user()
                    %li.dropdown.pull-right
                        %a.dropdown-toggle{href:"#", data-toggle:"dropdown"}
                            {{=current_user().username}}
                            %b.caret
                        %ul.dropdown-menu
                            %li
                                .col-xs-6.col-xs-offset-3
                                    %br
                                    %img.img-circle.img-responsive{src:"{{=userpic()}}"}
                                    %br
                            %li
                                %a{href:"#"}
                                    = T("Points")+": "
                                    = userdata()['points']
                            %li
                                %a{href:"#"}
                                    = T("Credits")+": "
                                    = userdata()['credits']
                            %li
                                %a{href:"#"} Profile
                            %li
                                %a{href:"{{=url('games.owned')}}"} My games
                            %li.divider
                            %li
                                %a{href:"{{=url('main.account', 'logout')}}"} Sign out
                - else
                    %li
                        %a{href:"{{=url('main.account', 'register')}}"} Sign up
                    %li
                        %a{href:"{{=url('main.account', 'login')}}"} Sign in
