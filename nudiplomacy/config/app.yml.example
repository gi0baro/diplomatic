# Auth settings
auth:
  server: default
  #formstyle: "divs"
  photo_source: ["gravatar", "facebook", "upload"]
  gender: ["male", "female"]
  registration_requires_verification: False
  registration_requires_approval: False
  #registration_requires_invitation: False
  use_username: True
# Mailer
mail:
  server: localhost
  sender: "noreply@nudiplomacy.com"
  login: ""
  tls: False
# Redis (mail queue)
redis:
  host: 127.0.0.1
  port: 6379
  db: 2
langs: ["en", "it"]
registration_codes: True
