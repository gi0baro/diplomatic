    lang = Field()
    nplayers = Field('int')
    bet = Field('int')
    pot_type = Field()
    phase_time = Field('int')
    join_time = Field('int')
    starts_on = Field()
    build_ew = Field('bool')
    build_onstart = Field('bool')
    anonymous = Field('bool')
    press_type = Field()
    countries_assign = Field()
    countries_enabled = Field('json')
    access = Field()
    password = Field()
    max_turns = Field('int')
    target_sc = Field('int')
    skip_proc = Field('list:string')
    status = Field()
    is_active = Field('bool')
    is_open = Field('bool')
    slots = Field('json')
    is_ready = Field('bool')
    created_at = Field('datetime')
    processed_at = Field('datetime')
    next_at = Field('datetime')
    countries = Field('json')
    phases = Field('json')

