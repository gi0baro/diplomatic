- v = form.custom.inpval
- labels = form.custom.label
- settings_url = url('front.auth.notifications.partial_settings')

%section#notification-settings.panel
    %h2.panel-title.px-4.pt-3.pb-2.border-b.border-ink-700
        = T("Emails")
    %form.p-4.space-y-4{method: "post", action: "{{=settings_url}}", "hx-post": "{{=settings_url}}", "hx-target": "#notification-settings", "hx-swap": "outerHTML"}
        %input{type: "hidden", name: "_csrf_token", value: "{{=form.formkey}}"}
        %label.flex.items-center.gap-3.cursor-pointer
            %input.sr-only{type: "checkbox", name: "email_enabled", "{{='checked' if v.email_enabled else ''}}": None}
            %span.toggle
            %span{class: "text-[13px] text-fog-200"}
                = labels.email_enabled
        - if fields
            .grid.gap-3.pt-4.border-t.border-ink-700{class: "sm:grid-cols-2"}
                - for name in fields
                    %label.flex.items-center.gap-3.cursor-pointer
                        %input.sr-only{type: "checkbox", name: "{{=name}}", "{{='checked' if v[name] else ''}}": None}
                        %span.toggle
                        %span{class: "text-[13px] text-fog-200"}
                            = labels[name]
        .flex.items-center.justify-end.gap-3
            - if saved
                %span.cap
                    = T("Saved")
            %button.btn.btn-primary{type: "submit"}
                = T("Save")
