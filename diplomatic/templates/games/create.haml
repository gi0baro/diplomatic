- extend 'legacy.haml'

.container
    .row
        %h1.center
            = T("Create a new game")
        .row.m-15
        %form.form-horizontal{enctype: "multipart/form-data", method: 'POST'}
            %fieldset
                - for field in ['map', 'name', 'lang', 'players_number', 'bet', 'pot_type', 'phase_time', 'build_everywhere', 'build_on_start', 'anonymous', 'press_type']
                    .form-group
                        %label.col-sm-2.control-label
                            = form.custom.label[field]
                        .col-sm-10
                            = form.custom.widget[field]
                            - if form.errors[field]
                                %p.text-danger
                                    = form.errors[field]
                            - if form.custom.comment[field]
                                %p.help-block
                                    = form.custom.comment[field]
                .form-group
                    %label.col-sm-2.control-label
                        = form.custom.label.countries_assignment
                    .col-sm-10
                        = form.custom.widget.countries_assignment
                        #games_countries_choice.row.m-15.nulled
                            .form-group
                                %label.col-sm-4.control-label
                                    = T("Pick your country:")
                                .col-sm-8
                                    %select#games_countries_choice_selection.form-control
                                    - if form.errors["countries_assignment"]
                                        %p.text-danger
                                            = form.errors["countries_assignment"]
                %textarea#games_countries_choice_hide{name: "country_choice", style: "display: none;"}
                .form-group
                    %label.col-sm-2.control-label
                        = form.custom.label.countries
                    .col-sm-10
                        = form.custom.widget.countries
                        %p.help-block
                            = form.custom.comment.countries
                .form-group
                    %label.col-sm-2.control-label
                        = form.custom.label.access
                    .col-sm-10
                        = form.custom.widget.access
                        #games_psw_c.row.m-15.nulled
                            .form-group
                                %label.col-sm-4.control-label
                                    = T("Enter the password:")
                                .col-sm-8
                                    %input#games_psw_hide.form-control{type: 'password', name: 'password'}
                                    - if form.errors["password"]
                                        %p.text-danger
                                            = form.errors["password"]
                .col-md-6.col-md-offset-3
                    .row.m-15{style: "text-align: center;"}
                        %h3{style: "color: #888"}
                            %i.fa.fa-cog
                            = T("Advanced settings")
                        .btn.btn-default{onclick: "act._gameFormToggleAdv();"}
                            %span#advanced-btn Show them
                            %i#advanced-btn-i.fa.fa-angle-down
                #advancedblock.col-md-12.nulled
                    .box.border
                        .row.m-15
                            - for field in ['join_time', 'starts_on', 'target_sc', 'max_turns', 'skip_processing']
                                .form-group
                                    %label.col-sm-2.control-label
                                        = form.custom.label[field]
                                    .col-sm-10
                                        = form.custom.widget[field]
                                        - if form.errors[field]
                                            %p.text-danger
                                                = form.errors[field]
                                        - if form.custom.comment[field]
                                            %p.help-block
                                                = form.custom.comment[field]
                .form-group
                    .col-sm-10.col-sm-offset-2
                        %input.btn.btn-primary{type: 'submit', value: 'Create'}
                %input{name: '_csrf_token', type: 'hidden', value: '{{=form.formkey}}'}
