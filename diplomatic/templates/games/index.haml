- footer_enabled = True
- extend 'layout.haml'

- modes = [('open', T('Open')), ('running', T('Running')), ('finished', T('Finished'))]

%div{"x-data": '{ view: localStorage.getItem("lobbyView") || "grid" }', "x-init": '$watch("view", (v) => localStorage.setItem("lobbyView", v))'}
    .flex.items-center.justify-between.gap-4.mb-6
        %h1.panel-title
            = T("Games")
        - if current_user()
            %a.btn.btn-primary{href: "{{=url('front.games.create')}}"}
                = T("Create a game")

    -# `mode` follows the URL so that an htmx history restore (which keeps this attribute) marks the right filter
    .flex.items-center.justify-between.gap-4.mb-4{"x-data": '{ mode: "{{=mode}}" }', "x-init": 'const m = new URLSearchParams(location.search).get("mode"); mode = ["running", "finished"].includes(m) ? m : "open"'}
        .seg{role: "group", "aria-label": "{{=T('Filter')}}"}
            - for m, label in modes
                %button{type: "button", class: "{{='on' if m == mode else ''}}", "data-mode": "{{=m}}", ":class": "{ on: mode === $el.dataset.mode }", "@click": "mode = $el.dataset.mode", "hx-get": "{{=url('front.games.partial_list', params=dict(mode=m))}}", "hx-target": "#games-list", "hx-swap": "outerHTML", "hx-push-url": "{{=url('front.games.index', params=dict(mode=m))}}"}
                    = label
        .seg{role: "group", "aria-label": "{{=T('View')}}"}
            - for v, label in [('grid', T('Grid')), ('table', T('Table'))]
                %button{type: "button", "data-view": "{{=v}}", ":class": "{ on: view === $el.dataset.view }", "@click": "view = $el.dataset.view"}
                    = label

    - include 'games/partials/list.haml'
