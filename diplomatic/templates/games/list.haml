- for game in games
    ---
        if game.bet >= 10 and game.bet < 30:
            betclass = "alert alert-info"
        elif game.bet >= 30 and game.bet < 50:
            betclass = "alert alert-success"
        elif game.bet >= 50 and game.bet < 85:
            betclass = "alert alert-warning"
        elif game.bet >= 85:
            betclass = "alert alert-danger"
        else:
            betclass = ""
        pass
    .col-md-4
        - include 'games/list_element.haml'
- if not games
    %h3
        = T("Seems we don't have any game to show up.")
