%div#chat{"data-x-data": 'chat({gameId: "{{=game.id}}", playerId: "{{=player_id}}", playerCountry: "{{=player_country}}", rooms: "{{=url("api.authorized.chat_rooms", game.id)}}", readings: "{{=url("api.authorized.chat_readings", game.id)}}", messages: "{{=url("api.authorized.chat_messages", ":ID:")}}", send: "{{=url("api.authorized.new_chat_message", game.id)}}", read: "{{=url("api.authorized.chat_read_message", [game.id, ":ID:"])}}", game: "{{=url("api.game_get", game.id)}}"})', "x-cloak": None, "x-show": "!none", class: "absolute z-30 flex flex-col rounded-sm border border-ink-600 bg-ink-900/95 backdrop-blur shadow-2xl shadow-black/50", style: "left:12px;top:-999px;width:340px"}
    %div{"data-resize": "n", "x-show": "!collapsed", title: "Resize", class: "absolute z-[1] left-2 right-3.5 -top-[3px] h-1.5 cursor-ns-resize"}
    %div{"data-resize": "e", "x-show": "!collapsed", title: "Resize", class: "absolute z-[1] top-3.5 bottom-2 -right-[3px] w-1.5 cursor-ew-resize"}
    %div{"data-resize": "ne", "x-show": "!collapsed", title: "Resize", class: "group absolute z-[1] -top-[3px] -right-[3px] h-3.5 w-3.5 cursor-nesw-resize"}
        %span{class: "absolute right-1 top-1 h-[7px] w-[7px] border-r-[1.5px] border-t-[1.5px] border-fog-500 group-hover:border-signal"}

    %div{"data-drag": None, class: "flex items-center gap-2 pl-2 pr-4 h-9 shrink-0 cursor-move select-none", ":class": '{"border-b border-ink-600": !collapsed}'}
        %span{class: "font-mono text-[10px] text-fog-500 leading-none", title: "Drag to move"} ⠿
        %span{class: "font-display font-semibold uppercase tracking-[.14em] text-[13px] text-fog-200 pr-1"} Chat
        %span.cap{"x-text": "roomCount()"}
        %span.badge{"x-show": "collapsed && totalUnread() > 0", "x-text": "totalUnread()", title: "Unread messages"}
        %button{type: "button", "@click": "toggle()", title: "Collapse / expand (C)", class: "ml-auto h-6 w-6 grid place-items-center text-fog-500 hover:text-fog-200 font-mono text-[11px]"}
            %span{class: "inline-block transition-transform", ":class": '{"rotate-180": collapsed}'} ▾

    %div{"x-show": "!collapsed", class: "flex flex-col flex-1 min-h-0"}
        %div{"x-show": "loadError", "x-text": "loadError", class: "shrink-0 px-3 py-1.5 border-b border-ink-600 font-mono text-[9.5px] tracking-[.12em] uppercase text-alert"}

        %div{class: "shrink-0 flex flex-wrap gap-1 px-2 py-1.5 border-b border-ink-600 max-h-[45%] overflow-y-auto"}
            %template{"x-for": "r in rooms", ":key": "r.id"}
                %button{type: "button", "@click": "open(r.id, true)", ":data-power": "r.key", ":title": "r.title", class: "inline-flex items-center font-mono text-[10.5px] font-medium tracking-[.02em] leading-4 px-1.5 py-0.5 rounded-sm whitespace-nowrap border", ":class": 'r.id === active ? "text-white bg-ink-700 border-[color:color-mix(in_srgb,var(--c,#9fe8ff)_70%,transparent)] shadow-[inset_0_-2px_0_var(--c,#9fe8ff)]" : (r.key ? "border-ink-600 text-[color:color-mix(in_srgb,var(--c)_80%,#5f7384)] hover:text-fog-200 hover:border-ink-500" : "border-ink-600 text-fog-400 hover:text-fog-200 hover:border-ink-500")'}
                    %span{"x-text": "r.label"}
                    %span.badge.ml-1{"x-show": "r.unread > 0", "x-text": "badge(r)"}
            %span{"x-show": "!ready", class: "font-mono text-[9.5px] tracking-[.15em] text-fog-500 py-0.5"} LOADING…

        %div{"x-ref": "list", class: "flex-1 min-h-0 overflow-y-auto px-3 py-2 flex flex-col gap-2.5"}
            %div{"x-show": "room() && room().more", class: "text-center"}
                %button.btn.btn-ghost{type: "button", "@click": "earlier()", ":disabled": "room() && room().loading", class: "py-0.5"} Earlier messages
            %div{"x-show": "room() && !room().loaded", class: "font-mono text-[9.5px] tracking-[.15em] text-fog-500 text-center pt-6"} LOADING…
            %div{"x-show": "room() && room().loaded && !room().messages.length", class: "font-mono text-[9.5px] tracking-[.15em] text-fog-500 text-center pt-6"} NO MESSAGES YET
            %template{"x-for": "m in messages()", ":key": "m.id"}
                %div{":class": 'kind(m) === "own" ? "flex flex-col items-end" : (kind(m) === "system" ? "flex justify-center" : "flex flex-col items-start")'}
                    %template{"x-if": 'kind(m) === "system"'}
                        %div{"x-text": "m.text", ":title": "stamp(m)", class: "px-4 text-center font-mono text-[9.5px] tracking-[.12em] uppercase text-fog-500 whitespace-pre-wrap break-words"}
                    %template{"x-if": 'kind(m) !== "system"'}
                        %div{class: "max-w-[88%] min-w-0"}
                            %div{class: "flex items-baseline gap-2 font-mono text-[9.5px] tracking-[.1em]", ":class": '{"justify-end": kind(m) === "own"}'}
                                %span{"x-show": "showSender(m)", "x-text": "senderLabel(m)", ":data-power": "senderKey(m)", ":title": "senderName(m)", class: "uppercase text-[color:var(--c,#b8c7d6)]"}
                                %span.text-fog-500{"x-text": "time(m)", ":title": "stamp(m)"}
                                %span.text-fog-500{"x-show": 'kind(m) === "own"'} you
                            %div{"x-text": "m.text", class: "text-[12.5px] leading-snug text-fog-300 whitespace-pre-wrap break-words", ":class": '{"text-right": kind(m) === "own"}'}

        %form{"@submit.prevent": "send()", autocomplete: "off", class: "shrink-0 border-t border-ink-600 px-2 py-2"}
            %div{class: "flex items-end gap-2"}
                %textarea.input{"x-ref": "composer", "x-model": "draft", rows: "1", ":placeholder": "placeholder()", ":disabled": "!room()", "@keydown.enter": "onEnter($event)", "@keydown.escape": "$el.blur()", "@input": "grow()", class: "flex-1 min-w-0 block resize-none max-h-24 overflow-y-auto"}
                %button.btn.btn-primary{type: "submit", ":disabled": "sending || !room() || !draft.trim()", class: "h-7 shrink-0"} Send
            %div{"x-show": "error", "x-text": "error", class: "pt-1.5 font-mono text-[9.5px] tracking-[.08em] text-alert"}
