#popover{"x-data": "popover", "x-show": "open", "x-cloak": None, ":data-power": "m.power", class: "absolute z-40 w-[272px] rounded-sm border border-ink-500 bg-ink-800/95 backdrop-blur shadow-2xl shadow-black/60", style: "left:-999px;top:12px"}
    %div{"data-drag": None, class: "cursor-move select-none flex items-center gap-2 px-3 pt-2.5 pb-2 border-b border-ink-600"}
        %span{class: "font-mono text-[10px] text-fog-500 leading-none", title: "Drag to move"} ⠿
        %span.sw.w-2.h-2.rounded-full
        %span{"x-text": 'is("coast") ? coastTitle : m.name', class: "font-display font-semibold text-[17px] tracking-[.1em] uppercase text-fog-200 leading-none truncate"}
        %button{type: "button", "@click": "close()", title: "Close (Esc)", class: "ml-auto text-fog-500 hover:text-fog-200 font-mono text-[12px]"} ✕
    %div{"x-show": '!is("coast")', "x-text": "detail", class: "cap px-3 py-1.5 border-b border-ink-600"}

    %div{"x-show": 'is("territory")', class: "p-1.5 space-y-0.5"}
        %button.pact{type: "button", ":class": '{on: isOn("hold")}', "@click": 'act("hold")'}
            %svg.ico{viewBox: "0 0 18 18", "aria-hidden": "true"}
                %polygon{points: "9,2 14,4 16,9 14,14 9,16 4,14 2,9 4,4"}
            Hold
            %span.ml-auto.flex.items-center.gap-2
                %span.cap no line
                %span.kbd H
        %button.pact{type: "button", ":class": '{on: isOn("move")}', "@click": 'act("move")'}
            %svg.ico{viewBox: "0 0 18 18", "aria-hidden": "true"}
                %path{d: "M2 9h10"}
                %path.fill{d: "M16.5 9l-7-3.5 2 3.5-2 3.5z"}
            Move
            %span.kbd.ml-auto M
        %button.pact{type: "button", ":class": '{on: isOn("support_hold")}', "@click": 'act("support_hold")'}
            %svg.ico{viewBox: "0 0 18 18", "aria-hidden": "true"}
                %path{d: "M2 15c2-6 5-8 8-8", "stroke-dasharray": "3 2"}
                %polygon{points: "16.8,8.4 14.9,10.3 12.1,10.3 10.2,8.4 10.2,5.6 12.1,3.7 14.9,3.7 16.8,5.6"}
            Support hold
            %span.kbd.ml-auto D
        %button.pact{type: "button", ":class": '{on: isOn("support_move")}', "@click": 'act("support_move")'}
            %svg.ico{viewBox: "0 0 18 18", "aria-hidden": "true"}
                %path{d: "M3 14c3-8 8-9 12-6", "stroke-dasharray": "3 2"}
                %circle{cx: "15", cy: "8", r: "1.8"}
            Support move
            %span.kbd.ml-auto S
        %button.pact{type: "button", ":class": '{on: isOn("convoy")}', ":disabled": "!m.canConvoy", "@click": 'act("convoy")'}
            %svg.ico{viewBox: "0 0 18 18", "aria-hidden": "true"}
                %circle{cx: "9", cy: "9", r: "6", "stroke-dasharray": "1 2.5"}
            Convoy
            %span.ml-auto.flex.items-center.gap-2
                %span.cap{"x-show": "!m.canConvoy"} no army in reach
                %span.kbd V

    %div{"x-show": 'is("build")', class: "p-1.5 space-y-0.5"}
        %button.pact{type: "button", ":class": '{on: isOn("build_army")}', ":disabled": "!m.canBuild", "@click": 'act("build_army")'}
            %svg.ico{viewBox: "0 0 18 18", "aria-hidden": "true"}
                %circle{cx: "9", cy: "9", r: "5", "stroke-dasharray": "2.5 1.5"}
                %path{d: "M14 2v4M12 4h4"}
            Build army
            %span.kbd.ml-auto A
        %button.pact{type: "button", ":class": '{on: isOn("build_fleet")}', ":disabled": "!m.canBuildFleet", "@click": 'act("build_fleet")'}
            %svg.ico{viewBox: "0 0 18 18", "aria-hidden": "true"}
                %path{d: "M9 15L15 4H3z", "stroke-dasharray": "2.5 1.5"}
                %path{d: "M14 11v4M12 13h4"}
            Build fleet
            %span.ml-auto.flex.items-center.gap-2
                %span.cap{"x-show": "m.canBuild && !m.canBuildFleet"} inland
                %span.cap{"x-show": "m.canBuildFleet && m.coasts"} pick a coast
                %span.kbd F
        %button.pact{type: "button", ":class": '{on: isOn("disband")}', ":disabled": "!m.canDisband", "@click": 'act("disband")'}
            %svg.ico{viewBox: "0 0 18 18", "aria-hidden": "true"}
                %path{d: "M4 4l10 10M14 4L4 14"}
            Disband
            %span.ml-auto.flex.items-center.gap-2
                %span.cap{"x-show": "!m.canDisband && m.canBuild"} no unit here
                %span.kbd D

    %div{"x-show": 'is("retreat")', class: "p-1.5 space-y-0.5"}
        %button.pact{type: "button", ":class": '{on: isOn("retreat")}', "@click": 'act("retreat")'}
            %svg.ico{viewBox: "0 0 18 18", "aria-hidden": "true"}
                %path{d: "M1.5 9h6", "stroke-dasharray": "2.5 1.5"}
                %path.fill{d: "M17 9l-5.5-3.2 1.6 3.2-1.6 3.2zM11.5 9L6 5.8 7.6 9 6 12.2z"}
            Retreat
            %span.kbd.ml-auto M
        %button.pact{type: "button", ":class": '{on: isOn("disband")}', "@click": 'act("disband")'}
            %svg.ico{viewBox: "0 0 18 18", "aria-hidden": "true"}
                %circle{cx: "9", cy: "9", r: "6.5", "stroke-dasharray": "1.5 2.2"}
                %path{d: "M6 6l6 6M12 6l-6 6"}
            Disband
            %span.kbd.ml-auto D

    %div{"x-show": 'is("coast")', class: "px-3 py-2 flex flex-wrap items-center gap-3"}
        %span.cap coast
        .seg
            %template{"x-for": "c in (m.coasts || [])", ":key": "c"}
                %button{type: "button", "@click": 'act("coast:" + c)', class: "inline-flex items-center gap-1.5"}
                    %span{"x-text": "c"}
                    %span.kbd{"x-text": "coastKey(c).toUpperCase()", "x-show": "coastKey(c)"}
        %span{class: "cap text-warn/80"} pick one

    %div{class: "px-3 py-2 border-t border-ink-600 flex items-center justify-between gap-2 font-mono text-[10px] text-fog-400"}
        %span.truncate.min-w-0{"x-text": "order"}
        %span.cap.shrink-0.whitespace-nowrap
            %span.kbd Esc
            cancel
