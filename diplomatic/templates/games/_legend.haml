%section#legend.mt-auto.border-t.border-ink-700{"x-data": "legend"}
    %button{type: "button", "@click": "toggle()", title: "Legend (L)", class: "w-full px-4 pt-2.5 pb-1.5 flex items-center justify-between text-left"}
        %span{class: "font-display uppercase tracking-wider text-[16px] text-fog-200 leading-none"} Legend
        %span{class: "flex items-center gap-2 font-mono text-[9.5px] text-fog-500 normal-case"}
            %svg{width: "11", height: "11", viewBox: "-6 -6 12 12", "aria-hidden": "true"}
                %circle{r: "4.6", fill: "#b8c7d6"}
            army
            %svg{width: "12", height: "11", viewBox: "-6 -6 12 12", "aria-hidden": "true"}
                %path{d: "M0 5.4L5.4 -4H-5.4Z", fill: "#b8c7d6"}
            fleet
            %svg{width: "11", height: "11", viewBox: "-6 -6 12 12", "aria-hidden": "true"}
                %path{d: "M0 -4.2L4.2 0L0 4.2L-4.2 0Z", fill: "#05080c", stroke: "#b8c7d6", "stroke-width": "1.3"}
            centre
            %span.kbd.ml-1 L
            %span{":class": '{"rotate-180": !open}', class: "inline-block transition-transform text-fog-500 font-mono text-[10px]"} ▾
    %div{"x-show": "open", class: "px-4 pb-2.5 font-mono text-[10px] text-fog-400"}
        %div{class: "grid grid-cols-2 gap-x-3 gap-y-0.5"}
            .flex.items-center.gap-2
                %svg.lg{viewBox: "0 0 34 16", "aria-hidden": "true"}
                    %path{d: "M2 8h25", stroke: "#e7eef4", "stroke-width": "2"}
                    %path{d: "M32 8l-11-5.5 3 5.5-3 5.5z", fill: "#e7eef4"}
                move
            .flex.items-center.gap-2
                %svg.lg{viewBox: "0 0 34 16", "aria-hidden": "true"}
                    %path{d: "M2 14Q14 0 27 6", fill: "none", stroke: "#e7eef4", "stroke-width": "1.8", "stroke-dasharray": "4 2.5"}
                    %circle{cx: "29", cy: "6.5", r: "2.8", fill: "#e7eef4", stroke: "#05080c", "stroke-width": ".8"}
                support move
            .flex.items-center.gap-2
                %svg.lg{viewBox: "0 0 34 16", "aria-hidden": "true"}
                    %path{d: "M2 14Q10 2 19 7", fill: "none", stroke: "#e7eef4", "stroke-width": "1.8", "stroke-dasharray": "4 2.5"}
                    %polygon{points: "31.5,10.3 29.5,13 26.3,13 24.4,10.3 24.4,5.7 26.3,3 29.5,3 31.5,5.7", fill: "rgba(231,238,244,.26)", stroke: "#e7eef4", "stroke-width": "1.4"}
                    %circle{cx: "28", cy: "8", r: "2.4", fill: "#b8c7d6"}
                support hold
            .flex.items-center.gap-2
                %svg.lg{viewBox: "0 0 34 16", "aria-hidden": "true"}
                    %path{d: "M2 12C8 2 16 2 24 7", fill: "none", stroke: "#e7eef4", "stroke-width": "2"}
                    %path{d: "M32 10l-10-5 3.5 4.5-1 5.5z", fill: "#e7eef4"}
                    %circle{cx: "13", cy: "5", r: "5", fill: "none", stroke: "#e7eef4", "stroke-width": "1.5", "stroke-dasharray": "1 2.6", "stroke-linecap": "round"}
                convoy
            .flex.items-center.gap-2
                %svg.lg{viewBox: "0 0 34 16", "aria-hidden": "true"}
                    %path{d: "M2 8h18", stroke: "#e7eef4", "stroke-width": "2", "stroke-dasharray": "6 3"}
                    %path{d: "M33 8l-8-4.4 2.4 4.4-2.4 4.4zM25.6 8l-8-4.4 2.4 4.4-2.4 4.4z", fill: "#e7eef4"}
                retreat
            .flex.items-center.gap-2
                %svg.lg{viewBox: "0 0 34 16", "aria-hidden": "true"}
                    %circle{cx: "15", cy: "9", r: "5.5", fill: "rgba(231,238,244,.2)", stroke: "#e7eef4", "stroke-width": "1.3", "stroke-dasharray": "2.5 1.5"}
                    %circle{cx: "22", cy: "4", r: "3.5", fill: "#05080c", stroke: "#e7eef4"}
                    %path{d: "M20.5 4h3M22 2.5v3", stroke: "#e7eef4"}
                build
            .flex.items-center.gap-2
                %svg.lg{viewBox: "0 0 34 16", "aria-hidden": "true"}
                    %circle{cx: "17", cy: "8", r: "4.5", fill: "#b8c7d6"}
                    %circle{cx: "17", cy: "8", r: "7", fill: "none", stroke: "#ff4d4d", "stroke-width": "1.2", "stroke-dasharray": "1.5 2"}
                    %path{d: "M13 4l8 8M21 4l-8 8", stroke: "#ff4d4d", "stroke-width": "1.6", "stroke-linecap": "round"}
                disband
            .flex.items-center.gap-2
                %svg.lg{viewBox: "0 0 34 16", "aria-hidden": "true"}
                    %path{d: "M2 8h25", stroke: "#e7eef4", "stroke-opacity": ".7", "stroke-width": "2"}
                    %path{d: "M32 8l-11-5.5 3 5.5-3 5.5z", fill: "#05080c", stroke: "#e7eef4", "stroke-width": "1.2", "stroke-linejoin": "round"}
                failed
            .flex.items-center.gap-2
                %svg.lg{viewBox: "0 0 34 16", "aria-hidden": "true"}
                    %circle{cx: "17", cy: "8", r: "6.8", fill: "rgba(255,77,77,.12)", stroke: "#ff4d4d", "stroke-width": "1.2", "stroke-dasharray": "3 2.4"}
                    %circle{cx: "17", cy: "8", r: "3.6", fill: "#b8c7d6", stroke: "#ff4d4d"}
                dislodged
            .flex.items-center.gap-2
                %svg.lg{viewBox: "0 0 34 16", "aria-hidden": "true"}
                    %rect{x: "3", y: "3", width: "28", height: "10", fill: "#1a2a37", stroke: "#9fe8ff", "stroke-width": "1.2", "stroke-dasharray": "1.5 2.5"}
                valid target
        %div{class: "mt-1.5 pt-1.5 border-t border-ink-700 text-[9px] leading-snug text-fog-500"} Current: yours, light, pulse in your colour. History: all, owner colour, still. Failed: hollow end.
        %div{title: "Keys are off while a text field has focus.", class: "mt-1.5 pt-1.5 border-t border-ink-700 space-y-1 text-[9.5px]"}
            %div
                %span.kbd ←
                %span.kbd →
                phase ·
                %span.kbd Home
                %span.kbd End
                first / last
            %div
                %span.kbd +
                %span.kbd −
                zoom ·
                %span.kbd 0
                reset ·
                %span.kbd Esc
                close / cancel
            %div
                %span.kbd C
                chat ·
                %span.kbd L
                legend ·
                %span.kbd R
                ready
