- card_play = url('front.games.play', game.id)
- card_joinable = bool(current_user()) and game.is_open and game.stage in (Game.Stage.PREGAME, Game.Stage.GAME) and not role
- card_open = 'true' if card_joinable and error else 'false'
- card_locked = game.is_open and game.access == Game.Access.PASSWORD

%article.panel.flex.flex-col.overflow-hidden{id: "game-{{=game.id}}", "data-game": "{{=game.id}}", "x-data": "{ joining: {{=card_open}} }", "@lobby-join.window": 'if ($event.detail === $el.dataset.game) { joining = true; $nextTick(() => $el.scrollIntoView({block: "center", behavior: "smooth"})) }'}
    %a.preview{href: "{{=card_play}}"}
        %img{src: "{{=url('map_files.thumb_svg', variant.id)}}", alt: "", loading: "lazy"}
    .p-4.flex-1.flex.flex-col
        .cap
            = variant.name
        .mt-1.5.flex.items-center.gap-2.min-w-0
            %a{href: "{{=card_play}}", class: "block truncate font-display font-semibold text-[20px] leading-none tracking-[.1em] uppercase text-fog-200 hover:text-signal"}
                = game.name
            - if card_locked
                %span.shrink-0.inline-flex.text-fog-500{title: "{{=T('Password protected')}}"}
                    %svg{width: "14", height: "14", role: "img", "aria-label": "{{=T('Password protected')}}"}
                        %use{href: "#i-lock"}
        .cap.mt-3
            {{=count}} / {{=game.players_number}} {{=T("players")}} · {{=game.bet}} {{=T("points")}} · {{=Game.PotType(game.pot_type).label}}
        .cap.mt-1
            %span{title: "{{=(T('Skips') + ': ' + skips) if skips else ''}}"}
                {{=duration(game.phase_time)}} {{=T("per turn")}}
            · {{=centers}} {{=T("centers")}}
            - if game.max_years
                · {{=game.max_years}} {{=T("years")}}
        .cap.mt-1
            - if game.stage == Game.Stage.OVER
                &nbsp;
            - elif lang
                {{=press}} · {{=lang}}
            - else
                = press
        .mt-2.h-3.flex.items-center.gap-1.5.text-fog-500
            - for icon, label in rules
                %span.inline-flex{title: "{{=label}}"}
                    %svg{width: "12", height: "12", role: "img", "aria-label": "{{=label}}"}
                        %use{href: "#i-{{=icon}}"}
        %div{class: "mt-auto pt-3 font-mono text-[12px] text-fog-200"}
            - if game.is_open
                - if game.stage == Game.Stage.GAME
                    .mb-1
                        - if turn
                            {{=turn}} ·
                        = status
                {{=T("Deadline")}}
                %span{"data-deadline": "{{=deadline_iso}}"}
                    = deadline
            - elif game.stage == Game.Stage.OVER
                - if winner
                    {{=T("Won by")}} {{=winner}}
                - else
                    = status
            - else
                - if turn
                    {{=turn}} ·
                = status
        - if error and not card_joinable
            .err.mt-3
                = error
        - if card_joinable
            %form.mt-4.pt-4.border-t.border-ink-700.space-y-3{"x-show": "joining", "x-cloak": None, "hx-post": "{{=url('front.games.join', game.id)}}", "hx-target": "#game-{{=game.id}}", "hx-swap": "outerHTML"}
                - if game.access == Game.Access.PASSWORD
                    .field
                        %label.label{for: "join-password-{{=game.id}}"}
                            = T("Password")
                        %input.input{id: "join-password-{{=game.id}}", type: "password", name: "password", required: None, autocomplete: "off"}
                - if choices is not None
                    .field
                        %label.label{for: "join-country-{{=game.id}}"}
                            = T("Country")
                        %select.input{id: "join-country-{{=game.id}}", name: "country"}
                            - for name in choices
                                %option{value: "{{=name}}"}
                                    = name
                .cap
                    - if game.stage == Game.Stage.GAME
                        = T("No stake required")
                    - else
                        {{=T("This stakes")}} {{=game.bet}} {{=T("points")}}
                - if error
                    .err
                        = error
                .flex.justify-end.gap-2
                    %button.btn{type: "button", "@click": "joining = false"}
                        = T("Cancel")
                    %button.btn.btn-primary{type: "submit"}
                        = T("Take over") if game.stage == Game.Stage.GAME else T("Confirm")
        .pt-4.flex.justify-end.gap-2
            - if role
                %a.btn.btn-primary{href: "{{=card_play}}"}
                    = T("Enter")
            - elif card_joinable
                %button.btn.btn-primary{type: "button", "x-show": "!joining", "@click": "joining = true"}
                    = T("Take over") if game.stage == Game.Stage.GAME else T("Join")
            - elif game.is_open
                %a.btn{href: "{{=url('auth.login')}}"}
                    = T("Sign in to join")
            - else
                %a.btn{href: "{{=card_play}}"}
                    = T("Watch")
