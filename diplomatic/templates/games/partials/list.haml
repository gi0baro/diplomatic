- list_empty = dict(open=T('No open games'), running=T('No running games'), finished=T('No finished games'))
- list_part = lambda p: url('front.games.partial_list', params=dict(mode=mode, page=p))
- list_page = lambda p: url('front.games.index', params=dict(mode=mode, page=p))

#games-list
    - if not games
        .panel.px-4.py-6.cap
            = list_empty[mode]
    - else
        .grid.gap-4{class: "md:grid-cols-2 lg:grid-cols-3", "x-show": 'view === "grid"'}
            - for game in games
                - variant = variants[game.id]
                - card = cards[game.id]
                - count, role, joinable, choices, winner, turn, status, press, lang = card['count'], card['role'], card['joinable'], card['choices'], card['winner'], card['turn'], card['status'], card['press'], card['lang']
                - rules, skips, centers = card['rules'], card['skips'], card['centers']
                - deadline_iso, deadline = card['deadline_iso'], card['deadline']
                - error = None
                - include 'games/partials/card.haml'
        .panel.overflow-x-auto{"x-show": 'view === "table"', "x-cloak": None}
            - list_cols = dict(open=['Press', 'Language', 'Turn length', 'Targets', 'Rules', 'Deadline'], running=['Press', 'Language', 'Turn length', 'Targets', 'Rules', 'Turn', 'Status'], finished=['Turn length', 'Targets', 'Result'])[mode]
            %table.table
                %thead
                    %tr
                        %th.w-full
                            = T("Name")
                        - for label in ['Variant', 'Players', 'Bet', 'Pot'] + list_cols
                            %th.whitespace-nowrap
                                = T(label)
                        %th
                %tbody
                    - for game in games
                        - row = cards[game.id]
                        - row_play = url('front.games.play', game.id)
                        %tr
                            %td
                                .flex.items-center.gap-2
                                    %a{href: "{{=row_play}}", class: "font-display font-semibold text-[14px] uppercase tracking-[.08em] text-fog-200 hover:text-signal"}
                                        = game.name
                                    - if game.is_open and game.access == Game.Access.PASSWORD
                                        %span.shrink-0.inline-flex.text-fog-500{title: "{{=T('Password protected')}}"}
                                            %svg{width: "12", height: "12", role: "img", "aria-label": "{{=T('Password protected')}}"}
                                                %use{href: "#i-lock"}
                            %td.whitespace-nowrap
                                = variants[game.id].name
                            %td.whitespace-nowrap
                                {{=row['count']}} / {{=game.players_number}}
                            %td.whitespace-nowrap
                                = game.bet
                            %td.whitespace-nowrap
                                = Game.PotType(game.pot_type).label
                            - if mode != 'finished'
                                %td.whitespace-nowrap
                                    = row['press_short']
                                %td.whitespace-nowrap
                                    = row['lang'] or '—'
                            %td.whitespace-nowrap{title: "{{=(T('Skips') + ': ' + row['skips']) if row['skips'] else ''}}"}
                                = duration(game.phase_time)
                            %td.whitespace-nowrap
                                {{=row['centers']}} / {{=game.max_years or '—'}}
                            - if mode != 'finished'
                                %td.whitespace-nowrap
                                    - if row['rules']
                                        .flex.items-center.gap-1.5
                                            - for icon, label in row['rules']
                                                %span.inline-flex.text-fog-500{title: "{{=label}}"}
                                                    %svg{width: "12", height: "12", role: "img", "aria-label": "{{=label}}"}
                                                        %use{href: "#i-{{=icon}}"}
                                    - else
                                        —
                            - if mode == 'open'
                                %td.whitespace-nowrap
                                    %span{"data-deadline": "{{=row['deadline_iso']}}"}
                                        = row['deadline']
                            - elif mode == 'running'
                                %td.whitespace-nowrap
                                    - if row['turn']
                                        = row['turn']
                                    - else
                                        —
                                %td.whitespace-nowrap
                                    = row['status']
                            - else
                                %td.whitespace-nowrap
                                    - if row['winner']
                                        {{=T("Won by")}} {{=row['winner']}}
                                    - else
                                        = row['status']
                            %td.text-right.whitespace-nowrap
                                - if row['role']
                                    %a.btn.btn-primary{href: "{{=row_play}}"}
                                        = T("Enter")
                                - elif row['joinable']
                                    %button.btn.btn-primary{type: "button", "data-game": "{{=game.id}}", "@click": 'view = "grid"; $nextTick(() => $dispatch("lobby-join", $el.dataset.game))'}
                                        = T("Take over") if game.stage == Game.Stage.GAME else T("Join")
                                - elif game.is_open and not current_user()
                                    %a.btn{href: "{{=url('auth.login')}}"}
                                        = T("Sign in to join")
                                - else
                                    %a.btn{href: "{{=row_play}}"}
                                        = T("Watch")
    - if page > 1 or has_next
        .mt-6.flex.items-center.justify-center.gap-4
            - if page > 1
                %a.btn{href: "{{=list_page(page - 1)}}", "hx-get": "{{=list_part(page - 1)}}", "hx-target": "#games-list", "hx-swap": "outerHTML", "hx-push-url": "{{=list_page(page - 1)}}"}
                    = T("Previous")
            %span.cap
                {{=T("Page")}} {{=page}}
            - if has_next
                %a.btn{href: "{{=list_page(page + 1)}}", "hx-get": "{{=list_part(page + 1)}}", "hx-target": "#games-list", "hx-swap": "outerHTML", "hx-push-url": "{{=list_page(page + 1)}}"}
                    = T("Next")
