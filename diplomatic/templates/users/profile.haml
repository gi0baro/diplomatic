- footer_enabled = True
- extend 'layout.haml'

.max-w-3xl.mx-auto
    .flex.items-center.gap-6.mb-6
        .avatar{class: "h-20 w-20 text-[24px]"}
            = (profile_user.username or '?')[:2].upper()
            - if profile_user.avatar_img
                %img{src: "{{=url('download', profile_user.avatar_img)}}", alt: "", onerror: "this.remove()"}
        .min-w-0
            %h1.break-words{class: "font-display uppercase tracking-wider text-[22px] text-fog-200"}
                = profile_user.username
            .cap.mt-2
                {{=T("Member since")}} {{=profile_user.created_at.strftime('%d %b %Y')}}

    .space-y-6
        %section.panel
            %h2.panel-title.px-4.pt-3.pb-2.border-b.border-ink-700
                = T("Stats")
            .p-4.grid.grid-cols-4.gap-4{class: "md:grid-cols-7"}
                - for field, label in [('score', 'Score'), ('points', 'Points'), ('played', 'Played'), ('won', 'Won'), ('survived', 'Survived'), ('defeated', 'Defeated'), ('drawn', 'Drawn')]
                    .space-y-1
                        .cap
                            = T(label)
                        %div{class: "font-mono text-[18px] tabular-nums text-fog-200"}
                            = stats[field] if stats else 0

        %section.panel
            %h2.panel-title.px-4.pt-4.pb-2
                = T("Games")
            - if not roles
                .px-4.py-6.cap
                    = T("No finished games")
            - else
                .overflow-x-auto
                    %table.table
                        %thead
                            %tr
                                %th.w-full
                                    = T("Game")
                                - for label in ['Variant', 'Country', 'Result', 'Centers']
                                    %th.whitespace-nowrap{class: "!text-right"}
                                        = T(label)
                        %tbody
                            - for entry in roles
                                - role = entry.game_roles
                                - game = entry.games
                                %tr
                                    %td
                                        %a{href: "{{=url('front.games.play', game.id)}}", class: "font-display font-semibold text-[14px] uppercase tracking-[.08em] text-fog-200 hover:text-signal"}
                                            = game.name
                                    %td.text-right.whitespace-nowrap
                                        = entry.maps.name
                                    %td.text-right.whitespace-nowrap
                                        = role.country
                                    %td.text-right.whitespace-nowrap
                                        = GameRole.State(role.state).label
                                    %td.text-right.whitespace-nowrap
                                        = role.supply_centers_owned
            - if page > 1 or has_next
                .flex.items-center.justify-between.gap-4.px-4.py-3.border-t.border-ink-700
                    %div
                        - if page > 1
                            %a.btn{href: "{{=url('front.users.profile', profile_user.username, page=page - 1)}}"}
                                = T("Prev")
                    %span.cap
                        {{=T("Page")}} {{=page}}
                    %div
                        - if has_next
                            %a.btn{href: "{{=url('front.users.profile', profile_user.username, page=page + 1)}}"}
                                = T("Next")
