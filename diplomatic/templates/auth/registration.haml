- footer_enabled = True
- extend 'layout.haml'

- custom = form.custom
- v = custom.inpval
- errors = form.errors
- invalid = lambda name: 'true' if errors.get(name) else 'false'

.max-w-sm.mx-auto
    %h1{class: "font-display uppercase tracking-wider text-[22px] text-fog-200 mb-6"}
        = T("Sign up")
    - if errors
        .toast.mb-6{role: "alert", class: "border-alert/40"}
            %span.toast-dot.text-alert
            %div{class: "flex-1 text-[13px] leading-snug text-fog-300"}
                = T("Check the fields marked below.")

    %section.panel
        %form{method: "post"}
            %input{type: "hidden", name: "_csrf_token", value: "{{=form.formkey}}"}
            .p-5.space-y-4
                .field
                    %label.label{for: "f-email"}
                        = custom.label.email
                    %input#f-email.input{type: "email", name: "email", required: None, autofocus: None, autocomplete: "email", value: "{{=v.email or ''}}", "aria-invalid": "{{=invalid('email')}}"}
                    - if errors.email
                        .err
                            = errors.email
                .field
                    %label.label{for: "f-username"}
                        = custom.label.username
                    %input#f-username.input{type: "text", name: "username", required: None, autocomplete: "username", value: "{{=v.username or ''}}", "aria-invalid": "{{=invalid('username')}}"}
                    - if errors.username
                        .err
                            = errors.username
                - for name in ['password', 'password2']
                    .field
                        %label.label{for: "f-{{=name}}"}
                            = custom.label[name]
                        %input.input{id: "f-{{=name}}", type: "password", name: "{{=name}}", required: None, autocomplete: "new-password", "aria-invalid": "{{=invalid(name)}}"}
                        - if errors.get(name)
                            .err
                                = errors[name]
                %button.btn.btn-primary{type: "submit"}
                    = form.attributes['submit']

    .mt-4{class: "font-mono text-[11px] tracking-[.12em] uppercase text-fog-500"}
        = T("Already registered?")
        %a{href: "{{=url('auth.login')}}", class: "text-fog-300 hover:text-fog-200"}
            = T("Sign in")
