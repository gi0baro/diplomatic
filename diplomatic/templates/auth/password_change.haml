- footer_enabled = True
- extend 'layout.haml'

- custom = form.custom
- errors = form.errors
- invalid = lambda name: 'true' if errors.get(name) else 'false'

.max-w-sm.mx-auto
    %h1{class: "font-display uppercase tracking-wider text-[22px] text-fog-200 mb-6"}
        = T("Change password")
    - if errors
        .toast.mb-6{role: "alert", class: "border-alert/40"}
            %span.toast-dot.text-alert
            %div{class: "flex-1 text-[13px] leading-snug text-fog-300"}
                = T("Check the fields marked below.")

    %section.panel
        %form{method: "post"}
            %input{type: "hidden", name: "_csrf_token", value: "{{=form.formkey}}"}
            .p-5.space-y-4
                - for name, complete in [('old_password', 'current-password'), ('new_password', 'new-password'), ('new_password2', 'new-password')]
                    .field
                        %label.label{for: "f-{{=name}}"}
                            = custom.label[name]
                        %input.input{id: "f-{{=name}}", type: "password", name: "{{=name}}", required: None, autocomplete: "{{=complete}}", "aria-invalid": "{{=invalid(name)}}"}
                        - if errors.get(name)
                            .err
                                = errors[name]
                %button.btn.btn-primary{type: "submit"}
                    = form.attributes['submit']

    .mt-4{class: "font-mono text-[11px] tracking-[.12em] uppercase text-fog-500"}
        %a{href: "{{=url('auth.profile')}}", class: "text-fog-300 hover:text-fog-200"}
            = T("Back to account")
