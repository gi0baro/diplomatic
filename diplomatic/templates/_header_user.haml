- current_user = locals().get('current_user', lambda: None)
- player_country = globals().get('player_country', None)
- player_key = globals().get('player_key', None)
- bell_poll = globals().get('bell_poll', False)
- header_join = globals().get('header_join', False)

.flex.items-center.gap-3.shrink-0.self-stretch
    - if current_user()
        - user = current_user()
        - vault = uservault()
        - bell_unread = unread_notifications()
        .relative.self-stretch.flex.items-center{"x-data": "{open: false}", "@click.outside": "open = false", "@keydown.escape.window": "open = false"}
            %button.nb.relative{type: "button", title: "{{=T('Notifications')}}", "aria-haspopup": "true", ":aria-expanded": "open", "@click": 'open = !open; if (open) htmx.trigger($refs.bell, "bell-open")'}
                %svg{width: "15", height: "15", "aria-hidden": "true"}
                    %use{href: "#i-bell"}
                %span#bell-count.badge.absolute{class: "-top-1 -right-1 {{='' if bell_unread else 'hidden'}}", "data-badge": None}
                    = bell_unread or ''
            - if bell_poll
                %div{"hx-get": "{{=url('front.auth.notifications.partial_count')}}", "hx-trigger": 'every 60s [document.visibilityState === "visible"]', "hx-swap": "none"}
            .absolute.right-0.top-full.mt-px.w-80.panel.border-t-0.rounded-t-none.shadow-2xl.z-40{class: "shadow-black/50", "x-ref": "bell", "x-show": "open", "x-cloak": None, "x-transition.opacity": None, "hx-get": "{{=url('front.auth.notifications.partial_bell')}}", "hx-trigger": "bell-open"}
                .px-3.py-4.cap
                    = T("Loading")
        - if player_country
            .flex.items-center.pl-3.border-l.border-ink-700{class: "gap-2.5", "data-power": "{{=player_key}}"}
                %span.sw.h-3.w-3
                %span{class: "font-display uppercase tracking-wider text-[16px] text-fog-200"}
                    = player_country
        - elif header_join
            .relative.self-stretch.flex.items-center{"x-data": "{joining: false}", "@click.outside": "joining = false", "@keydown.escape.window": "joining = false"}
                .pl-3.border-l.border-ink-700
                    %button.btn.btn-primary{type: "button", "aria-haspopup": "true", ":aria-expanded": "joining", "@click": "joining = !joining"}
                        = T("Take over") if game.stage == Game.Stage.GAME else T("Join")
                .absolute.right-0.top-full.mt-px.w-80.panel.border-t-0.rounded-t-none.shadow-2xl.z-40{class: "shadow-black/50", "x-show": "joining", "x-cloak": None, "x-transition.opacity": None}
                    - include 'games/partials/join.haml'
        .pl-3.border-l.border-ink-700{"x-data": "{open: false}", "@click.outside": "open = false", "@keydown.escape.window": "open = false"}
            %button.avatar{type: "button", "@click": "open = !open", "aria-haspopup": "true", title: "{{=user.username}}"}
                = (user.username or '?')[:2].upper()
                - if user.avatar_img
                    %img{src: "{{=userpic()}}", alt: "", onerror: "this.remove()"}
            .absolute.right-4.top-full.mt-px.w-52.py-1.panel.border-t-0.rounded-t-none.shadow-2xl.z-40{class: "shadow-black/50", "x-show": "open", "x-cloak": None, "x-transition.opacity": None}
                %div{class: "px-3 pt-1.5 font-mono text-[10px] tracking-[.12em] uppercase text-fog-500"}
                    = user.username
                %div{class: "px-3 pt-0.5 pb-1.5 font-mono text-[10px] tracking-[.12em] uppercase text-fog-300 border-b border-ink-700"}
                    {{=vault.balance}} points
                    - if vault.credit
                        %span.text-fog-400
                            · +{{=vault.credit}} staked
                %a{href: "{{=url('front.users.profile', user.username)}}", class: "block px-3 py-1.5 font-mono text-[11px] tracking-[.12em] uppercase text-fog-400 hover:text-fog-200 hover:bg-ink-800"}
                    = T("Profile")
                %a{href: "{{=url('auth.profile')}}", class: "block px-3 py-1.5 font-mono text-[11px] tracking-[.12em] uppercase text-fog-400 hover:text-fog-200 hover:bg-ink-800"}
                    = T("Account")
                %a{href: "{{=url('auth.logout')}}", class: "block px-3 py-1.5 font-mono text-[11px] tracking-[.12em] uppercase text-fog-400 hover:text-fog-200 hover:bg-ink-800 border-t border-ink-700"}
                    = T("Sign out")
    - else
        %a{href: "{{=url('auth.login')}}", class: "font-mono text-[11px] tracking-[.18em] uppercase text-fog-400 hover:text-fog-200"}
            = T("Sign in")
        %a.btn.btn-primary{href: "{{=url('auth.registration')}}"}
            = T("Sign up")
