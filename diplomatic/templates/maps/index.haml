- footer_enabled = True
- extend 'layout.haml'

.flex.items-baseline.justify-between.gap-4.mb-6
    %h1.panel-title
        = T("Variants")
    %span.cap
        {{=len(maps)}} {{=T("available")}}

- if not maps
    .panel.px-4.py-6.cap
        = T("No variants loaded")
- else
    .grid.gap-4{class: "md:grid-cols-2 lg:grid-cols-3"}
        - for map in maps
            %a.panel.group.block.overflow-hidden.transition-colors{href: "{{=url('front.maps.detail', map.id)}}", class: "hover:border-ink-500"}
                .preview
                    %img{src: "{{=url('map_files.thumb_svg', map.id)}}", alt: "", loading: "lazy"}
                .px-4.py-3
                    %div{class: "font-display font-semibold text-[20px] leading-none tracking-[.1em] uppercase text-fog-200 group-hover:text-signal"}
                        = map.name
                    .cap.mt-2
                        {{=len(map.countries)}} {{=T("players")}} · {{=map.games.count()}} {{=T("games")}}
