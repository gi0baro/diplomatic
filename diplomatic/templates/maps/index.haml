- extend 'layout.haml'

.card
    .row
        .col-xs-12
            %h2 Variants
            %table.table.table-hover.table-responsive
                %thead
                    %tr
                        %th
                        %th Name:
                        %th Games:
                %tbody
                    - for map in maps
                        %p
                            %tr
                                %td
                                    %a{href: '{{=url("front.maps.detail", map.id)}}'}
                                        %img{src: '{{=url("map_files.preview_svg", map.id)}}', style: "width: 240px"}
                                %td
                                    %a{href: '{{=url("front.maps.detail", map.id)}}'}
                                        = map.name
                                %td
