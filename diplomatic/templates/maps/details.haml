- extend 'layout.haml'

.row.m-15
    .col-xs-12
        %h2{style: "text-align: center;"}
            = map.name
        %br
        .row
            .col-md-8
                %img{src: '{{=url("map_files.preview_svg", map.id)}}', style: "width: 100%"}
            .col-md-4
                .col-md-8
                    = T("Land territories")
                .col-md-4
                    = len(map.names)-len(map.seas)-len(map.neutrals)
                .col-md-8
                    = T("Water territories")
                .col-md-4
                    = len(map.seas)
                .col-md-8
                    = T("Coastal territories")
                .col-md-4
                    = len(map.coasts)
                .col-md-8
                    = T("Supply centers")
                .col-md-4
                    = len(map.supply_centers)
                .col-md-8
                    = T("Supply centers to win")
                .col-md-4
                    = map.scs_to_win

